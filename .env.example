# Database
# REQUIRED: replace the placeholder with a unique random password. A copied
# placeholder can satisfy Compose interpolation, but the production preflight
# rejects it.
# Generate with: openssl rand -hex 32
DB_NAME=adversarygraph
DB_USER=ag_user
DB_PASS=CHANGE_ME_STRONG_LOCAL_PASSWORD

# Redis authentication — replace this with a different strong URL-safe random
# value (letters, digits, underscore, or hyphen only).
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
# External persistent Postgres data directory created on first deployment.
# Keep this folder when rebuilding containers; it stores private/custom data and synced references.
ADVERSARYGRAPH_DB_DIR=./data/postgres

# AI Provider Keys (at least one required for analysis features)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Local OpenAI-compatible LLM endpoint.
# Examples:
#   Ollama on host: LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LM Studio on host: LOCAL_LLM_BASE_URL=http://host.docker.internal:1234/v1
# Or use the private Compose-managed Ollama overlay documented in the quickstart;
# that overlay replaces this URL with the internal `http://ollama:11434/v1` URL.
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=llama3.1:8b
# Optional Compose-managed Ollama controls. The default image is version- and
# digest-pinned in docker-compose.local-ai.yml.
OLLAMA_KEEP_ALIVE=10m
OLLAMA_MEMORY_LIMIT=12g
OLLAMA_CPU_LIMIT=8.0

# Threat Hunting AI is advisory-only. Local AI is enabled by default; remote
# providers stay disabled until the operator explicitly approves that boundary.
THREAT_HUNTING_AI_ENABLED=true
THREAT_HUNTING_AI_CLOUD_ENABLED=false
THREAT_HUNTING_AI_DEFAULT_PROVIDER=local
THREAT_HUNTING_AI_TIMEOUT_SECONDS=45
THREAT_HUNTING_AI_SOURCE_CHAR_LIMIT=40000
THREAT_HUNTING_AI_MAX_CANDIDATES=3

# Allowlisted unified intelligence RAG across ATT&CK, groups, campaigns, actor
# observations, IOCs, CVEs, reports, Knowledge, Threat Radar, Threat Hunting,
# Evidence Graph, and sanitized assets. The default embedding model is expected
# at LOCAL_LLM_BASE_URL (for example: `ollama pull nomic-embed-text`). Keyword
# retrieval remains available when embeddings are disabled or temporarily down.
RAG_ENABLED=true
# Set true only after the private endpoint has the configured embedding model.
RAG_EMBEDDING_ENABLED=false
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_EMBEDDING_DIMENSIONS=768
RAG_EMBEDDING_BATCH_SIZE=32
RAG_VECTOR_MAX_COSINE_DISTANCE=0.55
RAG_CHUNK_CHARS=3500
RAG_CHUNK_OVERLAP_CHARS=350
RAG_DEFAULT_RESULT_LIMIT=12
RAG_MAX_CONTEXT_CHARS=32000
RAG_RECONCILE_HOUR=4
RAG_RECONCILE_MINUTE=15
# Derived-data retention. Set either day value to 0 to disable its automatic
# deletion for an operator-controlled legal hold. Backups are separate.
RAG_TOMBSTONE_RETENTION_DAYS=30
RAG_ASSISTANCE_RETENTION_DAYS=90
RAG_RETENTION_BATCH_SIZE=1000
RAG_RETENTION_MAX_BATCHES=20
RAG_RETENTION_HOUR=4
RAG_RETENTION_MINUTE=45
# Optional local MCP process. Stdio is the only supported transport; when
# AUTH_ENABLED=true, set a dedicated analyst bearer session token at process
# launch rather than committing it to this file.
MCP_TRANSPORT=stdio
MCP_API_BASE_URL=http://127.0.0.1:3000
MCP_API_TOKEN=
# Internal MalwareGraph -> AdversaryGraph LLM proxy. Keep this in docker compose.
ADVERSARYGRAPH_LLM_PROXY_URL=http://api:8000/api/malwaregraph/llm/complete
MALWAREGRAPH_AI_STRING_TIMEOUT_SECONDS=180
MALWAREGRAPH_AI_STRING_PROMPT_MAX_CHARS=120000

# ATT&CK Domains to ingest (comma-separated, no spaces)
# Options: enterprise-attack, mobile-attack, ics-attack, atlas
ATTCK_DOMAINS=enterprise-attack,mobile-attack,ics-attack,atlas

# IOC intelligence feeds.
# Free ThreatFox auth keys are available from abuse.ch Auth.
THREATFOX_AUTH_KEY=
# Start a non-blocking full IOC source sync after API startup.
# This refreshes ThreatFox, Malpedia, OTX, and enabled custom feeds.
AUTO_IOC_FULL_SYNC_ON_STARTUP=true
AUTO_THREATFOX_SYNC_DAYS=7
# Daily dynamic DB refresh in UTC: ATT&CK/ATLAS, MISP Galaxy, ThreatFox/Malpedia/OTX/custom feeds.
DYNAMIC_DB_SYNC_HOUR=3
DYNAMIC_DB_SYNC_MINUTE=30
DYNAMIC_DB_IOC_SYNC_DAYS=7
# Optional NVD API key. CVE sync works without it, but public rate limits are lower.
NVD_API_KEY=
# Optional AlienVault OTX key for actor-attributed pulse IOC sync.
OTX_API_KEY=
# Optional VirusTotal key for on-demand IOC reputation, TTP, and actor-context lookup.
VIRUSTOTAL_API_KEY=
# Optional investigation pivots. urlscan works without a key at public limits.
# GreyNoise Community is used by default and does not require a key.
URLSCAN_API_KEY=
# Reserved for future GreyNoise paid API support; not required for Community lookup.
GREYNOISE_API_KEY=
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=
# Censys Platform Personal Access Token and optional organization ID.
CENSYS_API_KEY=
CENSYS_ORG_ID=

# Inventory-bound Threat Radar asset assessment. Every network-executing tool
# runs in a separate private MCP container. Generate a distinct service token:
#   openssl rand -base64 36
ASSET_SCANNER_ENABLED=true
ASSET_SCANNER_MCP_TOKEN=
ASSET_SCANNER_MCP_TIMEOUT_SECONDS=240
ASSET_SCANNER_NMAP_ENABLED=true
ASSET_SCANNER_WEB_PROBE_ENABLED=true
ASSET_SCANNER_TLS_ENABLED=true
ASSET_SCANNER_DNS_ENABLED=true
ASSET_SCANNER_NUCLEI_ENABLED=true
ASSET_SCANNER_TIMEOUT_SECONDS=120
ASSET_SCANNER_WEB_PROBE_TIMEOUT_SECONDS=15
ASSET_SCANNER_TLS_TIMEOUT_SECONDS=15
ASSET_SCANNER_DNS_TIMEOUT_SECONDS=10
ASSET_SCANNER_NUCLEI_TIMEOUT_SECONDS=180
ASSET_SCANNER_NUCLEI_RATE_LIMIT=25
ASSET_SCANNER_NUCLEI_CONCURRENCY=5
ASSET_SCANNER_TOP_PORTS=100
ASSET_SCANNER_MAX_RESOLVED_IPS=4

# Product Security vulnerability, package, exploit, lifecycle, and exposure feeds.
# Core public feeds work without keys: CISA KEV, FIRST EPSS, OSV.dev, and public GitHub/NVD limits.
# Add optional keys/tokens below for higher limits, paid/private enrichment, and exposure monitoring.
# Uncomment and set only the providers you use.
# GITHUB_TOKEN=
# GITLAB_TOKEN=
# MSRC_API_KEY=
# DEPS_DEV_API_KEY=
# VULNCHECK_API_KEY=
# SNYK_TOKEN=
# SOCKET_TOKEN=
# ENDOFLIFE_DATE_TOKEN=
# HIBP_API_KEY=
# LEAKIX_API_KEY=
# SPYCLOUD_API_KEY=
# FLARE_API_KEY=
# DARKOWL_API_KEY=
# INTEL471_API_KEY=
# KELA_API_KEY=
# RECORDED_FUTURE_API_KEY=

# Optional OpenCTI symmetric sync.
# OPENCTI_URL is the base URL, for example https://opencti.example.com.
# OPENCTI_TOKEN is a personal/API token with permission to read indicators,
# observables, reports, labels, and create indicators/reports.
OPENCTI_URL=
OPENCTI_TOKEN=
OPENCTI_SYNC_LIMIT=500
OPENCTI_VERIFY_TLS=true

# MalwareGraph integrated malware-analysis module.
# Runs as a private service in docker-compose and is proxied through AdversaryGraph API.
MALWAREGRAPH_API_KEY=
MALWAREGRAPH_RETENTION_DAYS=7
MALWAREGRAPH_ENABLE_DYNAMIC_DEBUG=false
MALWAREGRAPH_REQUEST_TIMEOUT_SECONDS=30
MALWAREGRAPH_UPLOAD_TIMEOUT_SECONDS=180
MALWAREGRAPH_LONG_TIMEOUT_SECONDS=300
MALWAREGRAPH_MAX_UPLOAD_BYTES=268435456
MALWAREGRAPH_LOG_LEVEL=info
MALWAREGRAPH_MAX_LOG_BYTES=10485760
MALWAREGRAPH_LOG_BACKUP_COUNT=5

# Logging: debug, info, warning, error
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# CORS allowed origins — comma-separated list of frontend origins.
# In production set this to your actual domain, e.g.:
#   CORS_ALLOWED_ORIGINS=https://adversarygraph.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000
# HTTPS deployments must use secure session cookies. The production Compose
# overlay defaults this to true; set it explicitly only when overriding that
# policy for a reviewed environment.
# SECURE_COOKIES=true

# Optional team authentication and enterprise access.
# Native username/password login is available when AUTH_ENABLED=true.
# For first bootstrap only, set AUTH_BOOTSTRAP_ADMIN_PASSWORD to a strong
# temporary value, start the API, sign in as AUTH_BOOTSTRAP_ADMIN_USERNAME,
# create named users, then clear the bootstrap password.
# Roles: viewer, analyst, threat_intel, detection_engineer, incident_responder,
# auditor, security_admin, service_account, admin.
# Trusted OIDC/SAML reverse-proxy auth is supported when the proxy sets
# X-Auth-User and X-Auth-Roles and signs the request with PROXY_SECRET.
# WARNING: when AUTH_ENABLED=false, every request is treated as authenticated.
# Do not expose this instance to untrusted networks without enabling auth.
AUTH_ENABLED=false
AUTH_SSO_MODE=proxy
AUTH_DEFAULT_ROLE=viewer
AUTH_SESSION_MINUTES=720
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_REQUIRE_UPPER=false
AUTH_PASSWORD_REQUIRE_LOWER=false
AUTH_PASSWORD_REQUIRE_NUMBER=false
AUTH_PASSWORD_REQUIRE_SPECIAL=false
AUTH_MFA_ENABLED=false
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
# PROXY_SECRET must be set when using header-based auth behind a reverse proxy.
# The proxy must forward X-Internal-Proxy-Secret with this value and MUST strip
# any client-supplied X-Auth-User, X-Auth-Roles, and X-Internal-Proxy-Secret
# headers before proxying requests to the API.
PROXY_SECRET=
# Internal frontend-to-API trust secret used to accept the frontend TCP-peer IP
# for rate limiting. Generate an independent hex value with openssl rand -hex 32.
RATE_LIMIT_PROXY_SECRET=
# One-shot production-upgrade assertion for the preflight only. Prefer passing
# it on the command line after verifying a permanent named admin can sign in;
# do not leave it enabled as a substitute for that verification.
AUTH_EXISTING_ADMIN_CONFIRMED=false

# Production Compose deploys prebuilt, reviewed artifacts and never rebuilds
# them during `make prod`. Set every value to the registry digest recorded by
# the release workflow. Keep these commented for local source builds. In source
# mode, `docker compose pull` intentionally skips these buildable local targets
# and only refreshes the pinned third-party runtime images.
# ADVERSARYGRAPH_POSTGRES_IMAGE=ghcr.io/anpa1200/adversarygraph-postgres@sha256:<64-hex-digest>
# ADVERSARYGRAPH_BACKEND_IMAGE=ghcr.io/anpa1200/adversarygraph-backend@sha256:<64-hex-digest>
# ADVERSARYGRAPH_FRONTEND_IMAGE=ghcr.io/anpa1200/adversarygraph-frontend@sha256:<64-hex-digest>
# ADVERSARYGRAPH_MALWAREGRAPH_IMAGE=ghcr.io/anpa1200/adversarygraph-malwaregraph@sha256:<64-hex-digest>
# ADVERSARYGRAPH_ATTACK_LAB_WEB_IMAGE=ghcr.io/anpa1200/adversarygraph-attack-lab-web@sha256:<64-hex-digest>
# ADVERSARYGRAPH_ATTACK_LAB_ENDPOINT_IMAGE=ghcr.io/anpa1200/adversarygraph-attack-lab-endpoint@sha256:<64-hex-digest>
# ADVERSARYGRAPH_ANOMALY_DOCS_IMAGE=ghcr.io/anpa1200/adversarygraph-anomaly-docs@sha256:<64-hex-digest>

# Anomaly Detection Atlas snapshot and optional development synchronization
ATLAS_REPOSITORY=https://github.com/anpa1200/anomaly-detection-atlas.git
# Reviewed upstream commit bundled in the current post-v6 snapshot. Change only after review.
ATLAS_REPOSITORY_REF=819995c5681668ffd0c6a4e0f86b170b5a6bbbac
# Production disables post-deploy dependency/source replacement. Review and
# rebuild a new image to publish an Atlas source update.
ATLAS_SYNC_INTERVAL=0
REFERENCE_URL=http://localhost:3001/anomaly-detection-atlas

# Reviewed MalwareGraph commit used for reproducible image builds.
MALWAREGRAPH_REF=79f604c6b59522cc993c82d32e081e8357bba98a
