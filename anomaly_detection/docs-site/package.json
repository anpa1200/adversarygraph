{
  "name": "anomaly-detection-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Vendor-neutral anomaly detection reference covering statistical anomalies and security telemetry sources.",
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "test:image-size-boundary": "node vendor/image-size/test.cjs && npm run test:security-boundaries",
    "test:security-boundaries": "node vendor/braces-guard/test.cjs"
  },
  "dependencies": {
    "@docusaurus/core": "latest",
    "@docusaurus/preset-classic": "latest",
    "@mdx-js/react": "latest",
    "clsx": "latest",
    "image-size": "file:vendor/image-size",
    "ip-address": "10.7.4",
    "prism-react-renderer": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tar": "7.5.22",
    "tinypool": "2.2.0",
    "braces": "file:vendor/braces-guard"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "baseline-browser-mapping": "2.11.25",
    "browserslist": "4.29.0",
    "colord": "2.10.0",
    "fast-uri": "4.2.1",
    "gray-matter": {
      "js-yaml": "3.15.2"
    },
    "image-size": "$image-size",
    "ip-address": "$ip-address",
    "joi": "17.13.8",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "serialize-javascript": "^7.0.7",
    "qs": "6.16.0",
    "svgo": "3.3.5",
    "tar": "$tar",
    "uuid": "11.1.1",
    "tinypool": "$tinypool",
    "postcss-selector-parser": "7.1.6",
    "braces": "$braces",
    "undici": "6.28.1",
    "webpack-dev-middleware": "7.4.6"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
