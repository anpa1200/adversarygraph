{
  "name": "anomaly-detection-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Vendor-neutral anomaly detection reference covering statistical anomalies and security telemetry sources.",
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "generate:seo-dates": "node scripts/generate-seo-date-manifest.mjs",
    "check:seo-dates": "node scripts/generate-seo-date-manifest.mjs --check",
    "test:seo-dates": "node --test scripts/seo-date-manifest.test.cjs",
    "test:image-size-boundary": "node vendor/image-size/test.cjs"
  },
  "dependencies": {
    "@docusaurus/core": "latest",
    "@docusaurus/preset-classic": "latest",
    "@mdx-js/react": "latest",
    "clsx": "latest",
    "ip-address": "10.3.1",
    "prism-react-renderer": "latest",
    "react": "latest",
    "react-dom": "latest",
    "image-size": "file:vendor/image-size"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "4.1.2",
    "gray-matter": {
      "js-yaml": "3.15.1"
    },
    "image-size": "$image-size",
    "ip-address": "$ip-address",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "serialize-javascript": "^7.0.7",
    "uuid": "11.1.1"
  },
  "devDependencies": {},
  "browserslist": {
    "production": [">0.5%", "not dead", "not op_mini all"],
    "development": ["last 3 chrome version", "last 3 firefox version", "last 5 safari version"]
  },
  "engines": {
    "node": ">=18.0"
  }
}
